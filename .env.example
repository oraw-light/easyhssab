# GEMINI_API_KEY: Required for Gemini AI API calls (the AI Co-Pilot / /api/analyze route).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Postgres connection string used by Prisma (Settings > Database in the Supabase dashboard).
# Use the pooled "Transaction" connection string for DATABASE_URL, and the
# direct connection string for DIRECT_URL (needed by `prisma migrate`/`db push`).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
